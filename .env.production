# Committed on purpose (public URLs, no secrets). `next build` / `next start` load this file, so a plain
# production build is always wired to the same live APIs the production site uses and can never ship mock data.
# Local `next dev` and vitest do not load it: they stay in mock mode.
NEXT_PUBLIC_PAYLOAD_API_URL=https://api.quran.tech/api
NEXT_PUBLIC_CMS_API_URL=https://api.cms.itqan.dev/cms-api
