# ============================================================
# RATQ Community Platform — Environment Variables
# ============================================================

# Supabase Client (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo & Mock Mode (Enabled by default if Supabase credentials are empty)
VITE_ENABLE_DEMO_MODE=true

# Supabase Admin / Service Role (Used exclusively in Netlify Functions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Key Security Salts & Hashes
KEY_PEPPER=super_secret_pepper_random_string_at_least_32_chars
ENCRYPTION_KEY=super_secret_aes_256_encryption_key_32_bytes!

# Email Service (Resend or Postmark via Netlify Functions)
RESEND_API_KEY=re_123456789
EMAIL_FROM="RATQ Community <noreply@ratq.org>"

# AI & Embeddings (Netlify Scheduled Indexing Pipeline)
OPENAI_API_KEY=sk-proj-...

# Rate Limiting & Redis (Optional / Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
