# Read at BUILD time (inlined into the client bundle).
# Unset = mock/Demo mode (local dev and tests only). Set = live mode against the Payload API + Itqan CMS.
# `next build` loads .env.production (committed) which sets the production values below, and next.config.mjs
# refuses a production build without it. Override here only for local dev against a local Payload.
NEXT_PUBLIC_PAYLOAD_API_URL=
# Optional, default https://api.cms.itqan.dev/cms-api (only used in live mode)
# NEXT_PUBLIC_CMS_API_URL=

# Playwright (pnpm test:e2e), optional. Use a throwaway account, never a real user.
# BASE_URL=https://beta.ratq.itqan.dev
# E2E_EMAIL=
# E2E_PASSWORD=
