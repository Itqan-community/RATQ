# Only variable the app reads. Read at BUILD time (inlined into the client bundle).
# Unset = mock/Demo mode (no backend needed). Set = live mode against the Payload API.
# Production / beta value: https://api.ratq.itqan.dev/api
NEXT_PUBLIC_PAYLOAD_API_URL=

# Playwright (pnpm test:e2e), optional. Use a throwaway account, never a real user.
# BASE_URL=https://beta.ratq.itqan.dev
# E2E_EMAIL=
# E2E_PASSWORD=
